# Site URL (davet / şifre sıfırlama redirect için). Örn: https://fix.aiport.tr
NEXT_PUBLIC_SITE_URL=

# SubmitKit tamirat formu kimliği veya tam URL (public)
NEXT_PUBLIC_SUBMITKIT_FORM_ID=

# Supabase proje URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://yclcelejurcuavpkurcz.supabase.co

# Supabase anon / publishable key (public, client-side)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service_role secret — YALNIZCA sunucu tarafı; asla istemciye göndermeyin.
# Admin üye rolü ve tedarikçi daveti için gerekli (/panel/admin/uyeler, /panel/admin/tedarikciler).
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
